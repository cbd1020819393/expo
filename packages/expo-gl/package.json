{
  "license": "MIT",
  "devDependencies": {
    "@react-native/typescript-config": "0.79.5",
    "@types/react": "18.2.79",
    "@types/invariant": "^2.2.33",
    "@types/webgl2": "^0.0.6",
    "react": "18.2.0",
    "react-native": "0.72.5",
    "typescript": "5.0.4",
    "@react-native-oh/react-native-harmony-cli": "^0.77.50",
    "metro": "^0.81.0"
  },
  "author": "650 Industries, Inc.",
  "name": "@react-native-ohos/expo-gl",
  "description": "HarmonyOS (RNOH) adaptation of expo-gl: GLView as an OpenGL ES render target with an ExpoWebGLRenderingContext implementing the WebGL 2.0 specification subset.",
  "main": "./src/index.ts",
  "version": "1.0.0-beta.1",
  "keywords": [
    "react-native",
    "harmony",
    "harmonyos",
    "expo-gl",
    "webgl",
    "glview"
  ],
  "homepage": "https://docs.expo.dev/versions/latest/sdk/gl-view/",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-gl"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.72"
  },
  "dependencies": {
    "invariant": "^2.2.4"
  },
  "files": [
    "src/",
    "harmony/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "codegen-lib": "react-native codegen-harmony --cpp-output-path ./harmony/expo_gl/src/main/cpp/generated --ets-output-path ./harmony/expo_gl/src/main/ets/generated"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "harmony": {
    "alias": "expo-gl",
    "autolinking": {
      "cmakeLibraryTargetName": "expo_gl",
      "ohPackageName": "@react-native-ohos/expo-gl",
      "etsPackageClassName": "ExpoGlPackage",
      "cppPackageClassName": "ExpoGlPackage"
    },
    "codegenConfig": [
      {
        "version": 1,
        "specPaths": [
          "./src/specs/v1"
        ]
      }
    ]
  }
}
